[MAIN]
# Help Pylint recognize functions provided by Pygame.
extension-pkg-allow-list=pygame

[DESIGN]
# Game objects need values for movement, timers, scores, and other settings.
max-attributes=29
# Game uses separate methods for input, rules, and screen drawing.
max-public-methods=40
# The key handler has a branch for each screen and menu action.
max-branches=21
